<h1 class="archive-title"><%= __('archive') %></h1>

<% var year = 0; %>
<% page.posts.each(function(post){ %>
  <% var postYear = date(post.date, 'YYYY'); %>
  <% if (postYear !== year) { %>
    <% year = postYear; %>
    <h2 class="archive-year"><%= year %></h2>
  <% } %>
  <p class="archive-item">
    <time><%= date(post.date, 'MM-DD') %></time>
    <a href="<%- url_for(post.path) %>"><%= post.title %></a>
  </p>
<% }); %>

<% if (page.prev || page.next) { %>
<nav class="pagination">
  <% if (page.prev) { %>
    <a class="extend prev" href="<%- url_for(page.prev === 1 ? '/archives/' : '/archives/page/' + page.prev + '/') %>">← Prev</a>
  <% } %>
  <% if (page.next) { %>
    <a class="extend next" href="<%- url_for('/archives/page/' + page.next + '/') %>">Next →</a>
  <% } %>
</nav>
<% } %>
