<% page.posts.each(function(post){ %>
  <article class="post-item">
    <h2 class="post-title"><a href="<%- url_for(post.path) %>"><%= post.title %></a></h2>
    <time class="post-date"><%= date(post.date, 'YYYY-MM-DD') %></time>
    <div class="post-excerpt"><%- post.excerpt %></div>
  </article>
<% }); %>

<% if (page.prev || page.next) { %>
<nav class="pagination">
  <% if (page.prev) { %>
    <a class="extend prev" href="<%- url_for(page.prev === 1 ? '/' : '/page/' + page.prev + '/') %>">← Prev</a>
  <% } %>
  <% if (page.next) { %>
    <a class="extend next" href="<%- url_for('/page/' + page.next + '/') %>">Next →</a>
  <% } %>
</nav>
<% } %>
