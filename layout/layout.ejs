<!DOCTYPE html>
<html lang="<%= config.language %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= page.title ? page.title + ' | ' : '' %><%= config.title %></title>
  <%
  var rawDesc = page.description || page.excerpt || page.content || config.description || '';
  var desc = rawDesc ? strip_html(String(rawDesc)).trim().substring(0, 200) : '';
  var pageUrl = config.url + url_for(page.path);
  var ogType = page.layout === 'post' ? 'article' : 'website';
  %>
  <% if (desc) { %><meta name="description" content="<%= desc %>"><% } %>
  <meta property="og:title" content="<%= page.title || config.title %>">
  <% if (desc) { %><meta property="og:description" content="<%= desc %>"><% } %>
  <meta property="og:url" content="<%- pageUrl %>">
  <meta property="og:type" content="<%= ogType %>">
  <meta property="og:site_name" content="<%= config.title %>">
  <meta name="twitter:card" content="summary">
  <link rel="canonical" href="<%- pageUrl %>">
  <meta name="search-path" content="<%- url_for('/search.json') %>">
  <script>(function(){var t=localStorage.getItem('theme');if(!t)t=window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';document.documentElement.setAttribute('data-theme',t);})();</script>
  <%- css('css/style.css') %>
</head>
<body>
  <div class="site-wrapper">
    <header class="site-header">
      <div class="site-brand">
        <h1 class="site-title"><a href="<%- url_for('/') %>"><%= config.title %></a></h1>
        <% if (config.subtitle) { %><p class="site-subtitle"><%= config.subtitle %></p><% } %>
      </div>
      <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle theme">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
      </button>
      <button class="search-toggle" onclick="openSearch()" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </button>
      <nav class="site-nav">
        <a href="<%- url_for('/') %>" <% if (page.path === '' || page.type === 'index') { %>class="active"<% } %>>Home</a>
        <a href="<%- url_for('/archives') %>" <% if (page.type === 'archives') { %>class="active"<% } %>>Archives</a>
        <a href="<%- url_for('/about') %>" <% if (page.path && page.path.indexOf('about/') === 0) { %>class="active"<% } %>>About</a>
        <% if (site.tags && site.tags.length) { %>
        <a href="<%- url_for('/tags') %>" <% if (page.type === 'tags') { %>class="active"<% } %>>Tags</a>
        <% } %>
      </nav>
    </header>

    <div class="main-body">
      <% if (page.layout === 'post' && page.toc !== false) { %>
      <aside class="toc-sidebar" id="toc-sidebar">
        <div class="toc-sidebar-title">目录</div>
        <nav class="toc-nav"></nav>
      </aside>
      <% } %>

      <main class="content-card">
        <%- body %>
      </main>
    </div>

    <footer class="site-footer">
      <p>&copy; <%= date(Date.now(), 'YYYY') %> <%= config.author %></p>
    </footer>
  </div>

  <%- js('js/theme.js') %>
  <%- js('js/back-to-top.js') %>
  <%- js('js/copy-button.js') %>
  <%- js('js/toc.js') %>
  <%- js('js/language-label.js') %>
  <%- js('js/image-lightbox.js') %>
  <%- js('js/search.js') %>
</body>
</html>
